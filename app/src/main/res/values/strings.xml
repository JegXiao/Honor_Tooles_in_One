    <string name="setup_subtitle">集中管理 Shizuku、ADB 与特殊权限</string>
    <string name="shizuku_title">Shizuku（推荐）</string>
    <string name="shizuku_desc">Shizuku 让本应用以 shell 身份修改系统设置，无需 adb 授权或 root。导航切换、无线调试和性能模式都可以通过它完成。</string>
    <string name="shizuku_steps">1. 安装 Shizuku\n2. 按 Shizuku 内引导启动服务（Android 11+ 可用无线调试启动）\n3. 回到本页点击「授予权限」</string>
    <string name="shizuku_status_not_installed">状态：未安装 Shizuku</string>
    <string name="shizuku_status_not_running">状态：Shizuku 未运行</string>
    <string name="shizuku_status_not_granted">状态：Shizuku 已运行，尚未授权</string>
    <string name="shizuku_status_granted">状态：已授权，可直接一键切换</string>
    <string name="shizuku_open">打开 Shizuku</string>
    <string name="shizuku_grant">授予权限</string>
    <string name="shizuku_granted">已授权</string>
    <string name="shizuku_get">获取 Shizuku</string>
    <string name="toast_shizuku_granted">Shizuku 授权成功</string>
    <string name="toast_shizuku_not_running">Shizuku 未运行，请先启动 Shizuku</string>
    <string name="toast_shizuku_not_installed">未安装 Shizuku，请先安装并启动</string>
    <string name="adb_title">ADB 授权（备用）</string>
    <string name="adb_desc">不使用 Shizuku 时，可以在电脑上通过 ADB 执行一次下面的命令，为应用授予安全设置和「修改系统设置」权限。只需一次，之后无需电脑。</string>
    <string name="adb_status_granted">WRITE_SECURE_SETTINGS 已授权</string>
    <string name="adb_status_missing">WRITE_SECURE_SETTINGS 未授权</string>
    <string name="adb_command">adb shell pm grant %1$s android.permission.WRITE_SECURE_SETTINGS\nadb shell appops set %1$s android:write_settings allow</string>
    <string name="copy_command">复制命令</string>
    <string name="toast_copied">命令已复制</string>
    <string name="recheck">重新检查</string>
    <string name="toast_granted">授权成功，功能已可用</string>
    <string name="toast_still_missing">仍未检测到授权，请确认命令执行成功</string>
    <string name="root_grant">没有电脑？尝试 Root 一键授权</string>
    <string name="toast_root_trying">正在尝试 Root 授权…</string>
    <string name="toast_root_granted">Root 授权成功</string>
    <string name="toast_root_failed">Root 不可用或授权被拒绝</string>
    <string name="write_settings_title">修改系统设置</string>
    <string name="write_settings_status_granted">已授予「修改系统设置」权限</string>
    <string name="write_settings_status_missing">尚未授予「修改系统设置」权限</string>
    <string name="write_settings_desc">熄屏时间与性能模式（无 Shizuku 时）需要此权限。点击下方按钮前往系统设置开启。</string>
    <string name="write_settings_open">打开授权页面</string>
    <string name="help_title">使用说明</string>
    <string name="help_steps">• 下拉控制中心，点按编辑按钮，可把四个磁贴拖入常用区域。\n• 长按任意磁贴会回到本应用。\n• 桌面小组件为 2×2，四个格子分别对应四个功能。\n• Shizuku 重启后可能需要在 Shizuku 中重新授权本应用。</string>
    <string name="open_battery_settings">打开电池设置</string>
    <string name="security_note">说明：本应用只切换系统开关，不涉及网络传输。关闭无线调试会断开已建立的无线 ADB 连接，远程调试时请避免误触。切换导航方式后系统界面会短暂重载，属于正常现象。</string>
    <string name="toast_no_dev_options">无法打开开发者选项，请手动前往系统设置</string>

